{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "rootDir": "./",
        "outDir": "../../out-tsc/app",
        "types": [],
        "paths": {
            "@app/*": [
                "./src/app/*/index.ts"
            ],
            "@app/environment": [
                "./src/environment/environment.ts"
            ],
        }
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "src/**/*.spec.ts"
    ]
}
