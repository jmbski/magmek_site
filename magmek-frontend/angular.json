{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "cli": {
        "packageManager": "npm",
        "analytics": false
    },
    "newProjectRoot": "projects",
    "projects": {
        "aetherglow": {
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss"
                }
            },
            "root": "projects/aetherglow",
            "sourceRoot": "projects/aetherglow/src",
            "prefix": "ag",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "browser": "projects/aetherglow/src/main.ts",
                        "tsConfig": "projects/aetherglow/tsconfig.app.json",
                        "inlineStyleLanguage": "scss",
                        "assets": [
                            {
                                "glob": "**/*",
                                "input": "projects/aetherglow/public"
                            }
                        ],
                        "styles": [
                            "projects/aetherglow/src/styles.css",
                            "projects/aetherglow/src/ag-styles.scss"
                        ]
                    },
                    "configurations": {
                        "production": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "500kB",
                                    "maximumError": "1MB"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "4kB",
                                    "maximumError": "8kB"
                                }
                            ],
                            "fileReplacements": [
                                {
                                    "replace": "projects/aetherglow/src/environment/environment.ts",
                                    "with": "projects/aetherglow/src/environment/environment.prod.ts"
                                }
                            ],
                            "outputHashing": "all",
                            "baseHref": "/"
                        },
                        "development": {
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "configurations": {
                        "production": {
                            "buildTarget": "aetherglow:build:production"
                        },
                        "development": {
                            "buildTarget": "aetherglow:build:development"
                        }
                    },
                    "defaultConfiguration": "development"
                },
                "test": {
                    "builder": "@angular/build:unit-test"
                }
            }
        },
        "true-traffic": {
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss",
                    "skipTests": true
                }
            },
            "root": "projects/true-traffic",
            "sourceRoot": "projects/true-traffic/src",
            "prefix": "tt",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "browser": "projects/true-traffic/src/main.ts",
                        "tsConfig": "projects/true-traffic/tsconfig.app.json",
                        "inlineStyleLanguage": "scss",
                        "assets": [
                            {
                                "glob": "**/*",
                                "input": "projects/true-traffic/public"
                            }
                        ],
                        "styles": [
                            "projects/true-traffic/src/styles.css"
                        ]
                    },
                    "configurations": {
                        "production": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "500kB",
                                    "maximumError": "1MB"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "4kB",
                                    "maximumError": "8kB"
                                }
                            ],
                            "fileReplacements": [
                                {
                                    "replace": "projects/true-traffic/src/environment/environment.ts",
                                    "with": "projects/true-traffic/src/environment/environment.prod.ts"
                                }
                            ],
                            "outputHashing": "all",
                            "baseHref": "/"
                        },
                        "development": {
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "configurations": {
                        "production": {
                            "buildTarget": "true-traffic:build:production"
                        },
                        "development": {
                            "buildTarget": "true-traffic:build:development"
                        }
                    },
                    "defaultConfiguration": "development"
                },
                "test": {
                    "builder": "@angular/build:unit-test"
                }
            }
        },
        "shared-utils": {
            "projectType": "library",
            "root": "projects/shared-utils",
            "sourceRoot": "projects/shared-utils/src",
            "prefix": "mm",
            "architect": {
                "build": {
                    "builder": "@angular/build:ng-packagr",
                    "configurations": {
                        "production": {
                            "tsConfig": "projects/shared-utils/tsconfig.lib.prod.json"
                        },
                        "development": {
                            "tsConfig": "projects/shared-utils/tsconfig.lib.json"
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                        "tsConfig": "projects/shared-utils/tsconfig.spec.json"
                    }
                }
            }
        }
    }
}
